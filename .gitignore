# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
**/build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Environment credentials
/frontend/assets/.env
/frontend/assets/.env.*
!/frontend/assets/.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example

# Firebase project-specific configuration (generate locally)
/backend/.firebaserc
# /frontend/lib/config/firebase_options.dart is now tracked with a dynamic fallback
/frontend/android/app/google-services.json
/frontend/ios/Runner/GoogleService-Info.plist
/frontend/macos/Runner/GoogleService-Info.plist

# Signing keys and certificates
/frontend/android/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pem
**/*.key
**/service-account*.json
**/*serviceAccount*.json

# Local agent/editor state
/.agents/
/.codex/
/.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/.firebase/
firebase-debug.log
node_modules/
*.tmp
*.bak
*.orig

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/frontend/android/app/debug
/frontend/android/app/profile
/frontend/android/app/release

# Google Sign-In Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Used to verify Google ID tokens on POST /api/auth/google.
GOOGLE_SIGN_IN_CLIENT_ID=

# Cloudinary (free file uploads)
CLOUDINARY_CLOUD_NAME=cesiyg6z
CLOUDINARY_API_KEY=739484295666519
CLOUDINARY_API_SECRET=DvPMNJ3xLfT0YNQ6NP5lzYfFPQ0

# Backend
CORS_ORIGINS=*

# Chat encryption key (AES-256-GCM). MUST be set to a long random string;
# it never touches the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes stored chat history unreadable, so back it up separately.
# If left empty the backend still starts but stores chat text as plaintext.
MESSAGE_ENCRYPTION_KEY=

# MySQL (primary database; SQL_* names take effect, MYSQL_* also accepted)
SQL_HOST=192.185.48.158
SQL_PORT=3306
SQL_USER=bisublar_gt
SQL_PASS=
SQL_DATABASE=bisublar_gt

# Seed admin account for `npm run seed` (MySQL users table)
ADMIN_SEED_EMAIL=admin@gradtrack.edu.ph
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=System Administrator

# Gmail SMTP for password reset verification codes (use an App Password, not your regular password)

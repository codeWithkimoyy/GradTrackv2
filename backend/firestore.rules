rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isNotDisabled(uid) {
      let data = get(/databases/$(database)/documents/users/$(uid)).data;
      return !('disabled' in data) || !data.disabled;
    }

    function isSignedIn() {
      return request.auth != null && isNotDisabled(request.auth.uid);
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function currentUserRole() {
      return (request.auth != null && isNotDisabled(request.auth.uid))
          ? getUserRole(request.auth.uid)
          : null;
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    function isStaff() {
      return isAdmin();
    }

    function isAlumni() {
      return isSignedIn() && currentUserRole() != 'admin';
    }

    function ownerOfResource() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function isPublicResource() {
      return resource.data.visibility == 'public';
    }

    function canPublishContent() {
      return (request.resource.data.keys().hasAll(['title']) ||
              request.resource.data.keys().hasAll(['jobTitle'])) &&
             request.resource.data.visibility in ['public', 'private'];
    }

    function ownerOfJob() {
      return isSignedIn() && request.auth.uid == resource.data.createdBy;
    }

    function canOwnUpdate() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function canOwnCreate() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isAdmin() ||
                    (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() ||
                    (isSignedIn() &&
                      request.auth.uid == userId &&
                      request.resource.data.role == 'alumni' &&
                      exists(/databases/$(database)/documents/alumni_registry/$(request.resource.data.alumniId)));
      allow update: if isAdmin() ||
                    (isSignedIn() &&
                     request.auth.uid == userId &&
                     request.resource.data.role == resource.data.role &&
                     !request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasAny(['disabled', 'role',
                                   'approved', 'isVerified', 'alumniId']));
      allow delete: if isAdmin();
    }

    // ---------- ALUMNI REGISTRY (pre-registered Alumni IDs) ----------
    // Created by admins as the whitelist of Alumni IDs that may register.
    match /alumni_registry/{alumniId} {
      // Allows the unauthenticated registration screen to verify an ID exists.
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
                    // Activation: an alumni may flip *only their own* record
                    // from Pending to Active as part of creating their account
                    // (server-side re-checked by the app; the linked users
                    // document must already exist for the new account).
                    (isSignedIn() &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid))
                          .data.alumniId == alumniId &&
                      resource.data.status == 'pending' &&
                      request.resource.data.status == 'active' &&
                      !request.resource.data
                           .diff(resource.data)
                           .affectedKeys()
                           .hasAny([
                             'alumniId', 'fullName', 'course',
                             'graduationYear', 'createdAt',
                           ]));
    }

    // ---------- ALUMNI PRIVATE RECORDS ----------
    match /employment_records/{recordId} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    match /career_milestones/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    match /certificates/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    match /skills/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    // ---------- SURVEYS & RESPONSES ----------
    match /surveys/{surveyId} {
      allow read: if isStaff() || isAlumni() || isPublicResource();
      allow create, update: if isStaff() && canPublishContent();
      allow delete: if isStaff();
    }

    match /survey_responses/{responseId} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update: if canOwnUpdate();
      allow delete: if isStaff();
    }

    // ---------- PUBLIC CONTENT (announcements, events, jobs) ----------
    match /announcements/{id} {
      allow read: if isPublicResource() || isAlumni() || isStaff();
      allow create: if isStaff() && canPublishContent();
      allow update: if isStaff() && canPublishContent();
      allow delete: if isStaff();
    }

    match /events/{id} {
      allow read: if isPublicResource() || isAlumni() || isStaff();
      allow create: if isStaff() && canPublishContent();
      allow update: if isStaff() && canPublishContent();
      allow delete: if isStaff();
    }

    match /jobs/{id} {
      allow read: if isPublicResource() || isAlumni() || isStaff();
      allow create: if (isStaff() || isAlumni()) &&
                          canPublishContent() &&
                          isSignedIn() &&
                          request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isStaff() || ownerOfJob();
    }

    match /event_registrations/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow delete: if isStaff() || ownerOfResource();
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if isStaff() || canOwnCreate();
      allow update: if canOwnUpdate();
      allow delete: if isStaff() || ownerOfResource();
    }

    // ---------- REPORTS / LOGS / SETTINGS ----------
    match /reports/{id} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /activity_logs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /system_settings/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---------- MESSAGING ----------
    match /conversations/{conversationId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        (resource.data.keys().hasAny(['participantIds']) && request.auth.uid in resource.data.participantIds) ||
        isStaff()
      );
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.senderId
      );
      allow update, delete: if false;
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isNotDisabled(uid) {
      // `get(...).exists` is NOT a valid property in rules — use the
      // standalone exists() guard so a missing users doc doesn't throw.
      // Only a literal boolean `true` marks an account as disabled; any
      // other value ('false', 0, null, missing) stays enabled so a
      // mis-typed legacy field never silently locks a user out.
      return !exists(/databases/$(database)/documents/users/$(uid)) ||
             !('disabled' in get(/databases/$(database)/documents/users/$(uid)).data) ||
             get(/databases/$(database)/documents/users/$(uid)).data.disabled != true;
    }

    function isSignedIn() {
      return request.auth != null && isNotDisabled(request.auth.uid);
    }

    function getUserRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
          ? get(/databases/$(database)/documents/users/$(uid)).data.role
          : null;
    }

    function currentUserRole() {
      return (request.auth != null && isNotDisabled(request.auth.uid))
          ? getUserRole(request.auth.uid)
          : null;
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    function isStaff() {
      return isAdmin();
    }

    function isAlumni() {
      return isSignedIn() && currentUserRole() != 'admin';
    }

    function ownerOfResource() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function isPublicResource() {
      return resource.data.visibility == 'public';
    }

    function canPublishContent() {
      return (request.resource.data.keys().hasAll(['title']) ||
              request.resource.data.keys().hasAll(['jobTitle'])) &&
             request.resource.data.visibility in ['public', 'private'];
    }

    function ownerOfJob() {
      return isSignedIn() && request.auth.uid == resource.data.createdBy;
    }

    function canOwnUpdate() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function canOwnCreate() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function getUserAlumniId(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
             'alumniId' in get(/databases/$(database)/documents/users/$(uid)).data
        ? get(/databases/$(database)/documents/users/$(uid)).data.alumniId
        : null;
    }

    // A user is a conversation participant if their Firebase UID OR their
    // registry Alumni ID is listed, so both UID-keyed and ID-keyed legacy
    // conversation documents keep working.
    function isConversationParticipant(resource) {
      return isSignedIn() &&
             resource.data.keys().hasAny(['participantIds']) &&
             (request.auth.uid in resource.data.participantIds ||
              (getUserAlumniId(request.auth.uid) != null &&
               getUserAlumniId(request.auth.uid) in resource.data.participantIds));
    }

    // A conversation is readable when its id matches the caller's Firebase UID
    // or registry Alumni ID, or when the conversation doc lists them as a
    // participant. Mirrors isConversationParticipant without needing the doc
    // to be in-context, so it can be applied to foreign docs (e.g. the
    // conversation referenced by a message).
    function canReadConversation(conversationId) {
      return conversationId == 'conv_' + request.auth.uid ||
             conversationId == 'conv_' + getUserAlumniId(request.auth.uid) ||
             (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
              isConversationParticipant(
                  get(/databases/$(database)/documents/conversations/$(conversationId))));
    }

    function canReadMessage(message) {
      return isSignedIn() && (
        isStaff() ||
        request.auth.uid == message.data.senderId ||
        request.auth.uid == message.data.recipientId ||
        getUserAlumniId(request.auth.uid) == message.data.senderId ||
        getUserAlumniId(request.auth.uid) == message.data.recipientId ||
        (message.data.keys().hasAny(['conversationId']) &&
         canReadConversation(message.data.conversationId)) ||
        isConversationParticipant(message)
      );
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isAdmin() ||
                    (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() ||
                    (isSignedIn() &&
                      request.auth.uid == userId &&
                      request.resource.data.role == 'alumni' &&
                      ('alumniId' in request.resource.data) &&
                      exists(/databases/$(database)/documents/alumni_registry/$(request.resource.data.alumniId)));
      allow update: if isAdmin() ||
                    (isSignedIn() &&
                     request.auth.uid == userId &&
                     request.resource.data.role == resource.data.role &&
                     !request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasAny(['disabled', 'role',
                                   'approved', 'isVerified', 'alumniId']));
      allow delete: if isAdmin();
    }

    // ---------- ALUMNI REGISTRY (pre-registered Alumni IDs) ----------
    // Created by admins as the whitelist of Alumni IDs that may register.
    match /alumni_registry/{alumniId} {
      // Allows the unauthenticated registration screen to verify an ID exists.
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
                    // Activation: an alumni may flip *only their own* record
                    // from Pending to Active as part of creating their account
                    // (server-side re-checked by the app; the linked users
                    // document must already exist for the new account).
                    (isSignedIn() &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid))
                          .data.alumniId == alumniId &&
                      resource.data.status == 'pending' &&
                      request.resource.data.status == 'active' &&
                      !request.resource.data
                           .diff(resource.data)
                           .affectedKeys()
                           .hasAny([
                             'alumniId', 'fullName', 'course',
                             'graduationYear', 'createdAt',
                           ]));
    }

    // ---------- ALUMNI PRIVATE RECORDS ----------
    match /employment_records/{recordId} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    match /career_milestones/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    match /certificates/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    match /skills/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update, delete: if isStaff() || ownerOfResource();
    }

    // ---------- SURVEYS & RESPONSES ----------
    match /surveys/{surveyId} {
      allow read: if isStaff() || isAlumni() || isPublicResource();
      allow create, update: if isStaff() && canPublishContent();
      allow delete: if isStaff();
    }

    match /survey_responses/{responseId} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow update: if canOwnUpdate();
      allow delete: if isStaff();
    }

    // ---------- PUBLIC CONTENT (announcements, events, jobs) ----------
    match /announcements/{id} {
      allow read: if isPublicResource() || isAlumni() || isStaff();
      allow create: if isStaff() && canPublishContent();
      allow update: if isStaff() && canPublishContent();
      allow delete: if isStaff();
    }

    match /events/{id} {
      allow read: if isPublicResource() || isAlumni() || isStaff();
      allow create: if isStaff() && canPublishContent();
      allow update: if isStaff() && canPublishContent();
      allow delete: if isStaff();
    }

    match /jobs/{id} {
      allow read: if isPublicResource() || isAlumni() || isStaff();
      allow create: if (isStaff() || isAlumni()) &&
                          canPublishContent() &&
                          isSignedIn() &&
                          request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isStaff() || ownerOfJob();
    }

    match /event_registrations/{id} {
      allow read: if isStaff() || ownerOfResource();
      allow create: if canOwnCreate();
      allow delete: if isStaff() || ownerOfResource();
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{id} {
      allow read: if isStaff() || ownerOfResource();
      // Alumni may address a notification to the admins as a role broadcast
      // (e.g. an alert when they send the alumni office a message).
      allow create: if isStaff() || canOwnCreate() ||
                    (isSignedIn() &&
                     request.resource.data.userId == '' &&
                     request.resource.data.recipientRole == 'admin');
      allow update: if canOwnUpdate() ||
                    (isStaff() && resource.data.recipientRole == 'admin');
      allow delete: if isStaff() || ownerOfResource();
    }

    // ---------- REPORTS / LOGS / SETTINGS ----------
    match /reports/{id} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /activity_logs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /system_settings/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---------- MESSAGING ----------
    match /conversations/{conversationId} {
      allow read: if isConversationParticipant(resource) ||
                    isStaff() ||
                    canReadConversation(conversationId);
      allow update, delete: if isConversationParticipant(resource) ||
                               isStaff();
      allow create: if isStaff() ||
                    (isSignedIn() &&
                     request.resource.data.keys().hasAny(['participantIds']) &&
                     (request.auth.uid in request.resource.data.participantIds ||
                      request.resource.data.alumniId == getUserAlumniId(request.auth.uid)));
    }

    match /messages/{messageId} {
      allow read: if canReadMessage(resource);
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.senderId
      );
      allow update, delete: if false;
    }
  }
}
# Firebase Web credentials (from Firebase Console -> Project Settings -> Web app)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
FIREBASE_ANDROID_APP_ID=

# Google Sign-In Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_SIGN_IN_CLIENT_ID=

# Cloudinary configuration
# Client uses an unsigned upload preset or requests signature from backend /api/upload/sign
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_UPLOAD_PRESET=gradtrack_uploads
BACKEND_API_URL=http://localhost:3000

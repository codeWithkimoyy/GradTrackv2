# Firebase Web credentials (from Firebase Console -> Project Settings -> Web app)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
FIREBASE_ANDROID_APP_ID=

# Google Sign-In Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_SIGN_IN_CLIENT_ID=

# Cloudinary configuration
# SECURITY: Never ship CLOUDINARY_API_SECRET in a production client build.
# Use a backend signing endpoint for signed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
